import sys
if sys.platform == "win32":
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    if hasattr(sys.stderr, "reconfigure"):
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")

import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader, random_split
from torchvision import datasets, transforms

# 1. 텔레메트리 SDK 임포트 (train_real.py와 동일 패턴)
from portfolio_demo.telemetry.interceptor import install_error_interceptor
from portfolio_demo.telemetry.tracker import DiffStackTracker
from portfolio_demo.telemetry.recorder import TrainRecorder

# 에러 인터셉터 즉시 활성화 (런타임 Exception 발생 시 last_error.json에 덤프)
install_error_interceptor()


class SimpleCNN(nn.Module):
    """2-conv-layer CNN — 처음부터 학습되는 가벼운 이미지 분류기."""

    def __init__(self):
        super().__init__()
        self.conv1 = nn.Conv2d(1, 16, kernel_size=3, padding=1)
        self.conv2 = nn.Conv2d(16, 32, kernel_size=3, padding=1)
        self.pool = nn.MaxPool2d(2, 2)
        # ── [실습 과제 · 의도된 오류] ────────────────────────────────────────
        # 첫 실행에서 "mat1 and mat2 shapes cannot be multiplied" 가 납니다.
        # 힌트: 28×28 입력이 MaxPool(2,2)을 두 번 지나면 몇×몇이 될까요?
        # in_features를 직접 계산해 고친 뒤 다시 실행하세요 — 에러와 수정 diff가
        # 그대로 포트폴리오의 '에러 해결' 서사로 기록됩니다.
        self.fc = nn.Linear(32 * 14 * 14, 10)

    def forward(self, x):
        x = self.pool(F.relu(self.conv1(x)))
        x = self.pool(F.relu(self.conv2(x)))
        x = x.view(x.size(0), -1)
        return self.fc(x)


def evaluate(model, loader, device):
    model.eval()
    correct, total, loss_sum = 0, 0, 0.0
    with torch.no_grad():
        for x, y in loader:
            x, y = x.to(device), y.to(device)
            logits = model(x)
            loss_sum += F.cross_entropy(logits, y, reduction="sum").item()
            correct += (logits.argmax(dim=1) == y).sum().item()
            total += y.size(0)
    model.train()
    return {"loss": round(loss_sum / total, 4), "accuracy": round(correct / total, 4)}


def main():
    # 2. 트래커 인스턴스 초기화
    tracker = DiffStackTracker(
        project_name="$project_name",
        task_type="$task_type"
    )

    # 3. 데이터 로드 및 전처리
    print("[1/4] 데이터셋 로드 및 전처리 시작...")
    transform = transforms.Compose([
        transforms.ToTensor(),
        transforms.Normalize((0.1307,), (0.3081,))
    ])
    full_dataset = datasets.MNIST(root="./data", train=True, download=True, transform=transform)

    raw_count = len(full_dataset)
    train_size = int(raw_count * 0.8)
    val_size = raw_count - train_size
    train_dataset, val_dataset = random_split(full_dataset, [train_size, val_size])
    processed_count = len(train_dataset)

    # [데이터 전처리 통계 텔레메트리 기록]
    tracker.log_dataset(
        raw_len=raw_count,
        processed_len=processed_count,
        notes=[
            "정규화(Normalize) 및 텐서 변환",
            "학습/검증 8:2 분할"
        ],
        avg_len_before=784.0,
        avg_len_after=784.0
    )

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = SimpleCNN().to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=$learning_rate)

    train_loader = DataLoader(train_dataset, batch_size=$batch_size, shuffle=True)
    val_loader = DataLoader(val_dataset, batch_size=$batch_size)

    # 4. 베이스라인 평가 지표 (학습 전 랜덤 초기화 상태)
    baseline_metrics = evaluate(model, train_loader, device)

    # 시각화용 기록기 — 5스텝마다 전체 가중치 프레임 저장 (약 18MB), .telemetry/viz/<run_id>/
    recorder = TrainRecorder(model, run_id=tracker.run_id, every=5, hparams={
        "batch_size": $batch_size, "learning_rate": $learning_rate, "epochs": $epochs,
        "optimizer": "Adam", "loss": "cross_entropy", "steps_per_epoch": len(train_loader),
    })

    print("[2/4] 모델 학습 실행...")
    steps_per_epoch = len(train_loader)
    for epoch in range($epochs):
        for i, (x, y) in enumerate(train_loader):
            x, y = x.to(device), y.to(device)
            optimizer.zero_grad()
            loss = F.cross_entropy(model(x), y)
            loss.backward()
            optimizer.step()
            recorder.record(loss.item(), epoch=epoch + (i + 1) / steps_per_epoch)
        print(f"  epoch {epoch + 1}/$epochs 완료")

    print("[3/4] 최종 성능 평가...")
    final_metrics = evaluate(model, val_loader, device)

    # 5. 최종 벤치마크 및 하이퍼파라미터 기록
    tracker.log_benchmarks(
        baseline=baseline_metrics,
        final=final_metrics,
        params={
            "base_model": "$base_model",
            "optimizer": "Adam",
            "learning_rate": $learning_rate,
            "batch_size": $batch_size,
            "epochs": $epochs
        }
    )

    # 6. 텔레메트리 병합 저장 (raw_telemetry.json 덤프)
    print("[4/4] 텔레메트리 저장 중...")
    tracker.save_run()
    print("✅ 실제 학습 텔레메트리 수집 완료: .telemetry/raw_telemetry.json")


if __name__ == "__main__":
    main()
