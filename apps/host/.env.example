# GPU 호스트 서버 설정. 전부 선택. 값이 없으면 로컬 개발 기본값.
# 실제 값은 이 파일에 적지 말고 실행 환경의 환경변수로 준다. (.env는 gitignore 대상)

PLAIGROUND_PORT=8770                 # API 서버 포트 (127.0.0.1 전용)
PLAIGROUND_VAR_DIR=                  # 런타임 데이터 루트. 기본 <repo>/var
PLAIGROUND_IDE_PORT=8080             # code-server 호스트 포트
PLAIGROUND_IDE_URL=                  # 브라우저가 여는 IDE 주소. 기본 http://127.0.0.1:<IDE_PORT>
PLAIGROUND_ALLOWED_ORIGINS=          # CORS 허용 오리진, 쉼표 구분. 예: https://plaiground.pages.dev
PLAIGROUND_AUTH=off                  # off | supabase
SUPABASE_URL=                        # AUTH=supabase 일 때 필수. https://<project>.supabase.co
SUPABASE_ANON_KEY=                   # AUTH=supabase 일 때 필수. 공개 키 (service_role 아님)

# Gemini: 사용자 키는 요청 헤더 X-Gemini-Key로 받는다. 아래는 헤더가 없을 때의 로컬 폴백.
# 위치: apps/host/plaiground_host/portfolio/.env
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
