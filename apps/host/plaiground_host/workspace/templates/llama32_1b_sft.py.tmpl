# 자동 생성됨 (apps/host/plaiground_host/workspace/templates/llama32_1b_sft.py.tmpl) — 직접 수정해도 됨, 재생성 시 덮어써짐.
import os
import sys
if sys.platform == "win32":
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    if hasattr(sys.stderr, "reconfigure"):
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")

import math
import torch
from transformers import (
    AutoModelForCausalLM, AutoTokenizer, DataCollatorForLanguageModeling,
    Trainer, TrainingArguments,
)
from datasets import load_dataset, Dataset
from peft import LoraConfig, get_peft_model

# 1. 텔레메트리 SDK 임포트
from plaiground_telemetry.interceptor import install_error_interceptor
from plaiground_telemetry.tracker import DiffStackTracker

install_error_interceptor()

MODEL_NAME = "$base_model"  # meta-llama/Llama-3.2-1B — 게이트 모델


def load_koalpaca():
    """KoAlpaca-v1.1a 1,000개 서브셋. 오프라인이면 내장 미니 샘플로 폴백."""
    try:
        ds = load_dataset("beomi/KoAlpaca-v1.1a", split="train[:1000]")
        return ds, 1000
    except Exception as e:
        print(f"경고: 원격 데이터셋 로드 실패 ({e}) — 내장 샘플로 대체합니다.")
        rows = {
            "instruction": [
                "딥러닝에서 과적합을 줄이는 대표적인 방법 두 가지를 설명해줘.",
                "경사하강법이 무엇인지 한 문장으로 설명해줘.",
                "배치 정규화의 효과를 간단히 설명해줘.",
            ] * 100,
            "output": [
                "드롭아웃으로 뉴런 일부를 무작위로 끄고, 조기 종료로 검증 손실이 오르기 전에 학습을 멈추는 방법이 있습니다.",
                "경사하강법은 손실 함수의 기울기를 따라 파라미터를 조금씩 이동시켜 손실을 최소화하는 최적화 방법입니다.",
                "배치 정규화는 각 층 입력 분포를 안정화해 학습을 빠르고 안정적으로 만들어 줍니다.",
            ] * 100,
        }
        return Dataset.from_dict(rows), 300


def main():
    if not (os.environ.get("HF_TOKEN") or os.environ.get("HUGGING_FACE_HUB_TOKEN")):
        print("안내: meta-llama/Llama-3.2-1B 는 게이트 모델입니다.")
        print("  1) https://huggingface.co/meta-llama/Llama-3.2-1B 에서 라이선스 동의")
        print("  2) 터미널에서 HF_TOKEN 환경변수 설정 후 재실행")
        # 토큰 없이도 진행은 시도한다 — 캐시가 있으면 성공할 수 있다.

    # 2. 트래커 초기화
    tracker = DiffStackTracker(project_name="$project_name", task_type="$task_type")

    # 3. 데이터 로드 및 전처리
    print("[1/4] KoAlpaca 지시 데이터 로드 및 전처리...")
    dataset, raw_count = load_koalpaca()
    dataset = dataset.filter(
        lambda x: x.get("instruction") and x.get("output") and len(str(x["output"]).strip()) > 10
    )
    processed_count = len(dataset)

    tracker.log_dataset(
        raw_len=raw_count,
        processed_len=processed_count,
        notes=[
            "출력 10자 미만의 저품질 응답 필터링",
            "instruction/output 결측 샘플 제거",
            "Alpaca 프롬프트 포맷으로 직렬화 후 max_length $max_length 트렁케이션",
        ],
        avg_len_before=0.0,
        avg_len_after=0.0,
    )

    # 4. 토크나이저/모델 + LoRA
    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
    # ── [실습 과제 · 의도된 오류] ────────────────────────────────────────
    # 첫 실행에서 "Asking to pad but the tokenizer does not have a padding token" 이 납니다.
    # 힌트: Llama 계열 토크나이저는 pad_token이 정의돼 있지 않습니다.
    #       커뮤니티 글 'LlamaTokenizer pad_token KeyError'를 참고해 한 줄을 추가하세요.

    model = AutoModelForCausalLM.from_pretrained(
        MODEL_NAME,
        torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32,
    )
    lora = LoraConfig(r=$lora_r, lora_alpha=16, target_modules=["q_proj", "v_proj"], task_type="CAUSAL_LM")
    model = get_peft_model(model, lora)
    model.print_trainable_parameters()

    def to_text(ex):
        return {"text": f"### 지시:\n{ex['instruction']}\n\n### 응답:\n{ex['output']}"}

    def tokenize_fn(batch):
        return tokenizer(batch["text"], truncation=True, max_length=$max_length)

    tokenized = dataset.map(to_text).map(tokenize_fn, batched=True, remove_columns=dataset.column_names)
    split = tokenized.train_test_split(test_size=0.1, seed=42)
    collator = DataCollatorForLanguageModeling(tokenizer, mlm=False)

    args = TrainingArguments(
        output_dir="./results_llama32",
        num_train_epochs=$epochs,
        per_device_train_batch_size=$batch_size,
        gradient_accumulation_steps=4,
        learning_rate=$learning_rate,
        eval_strategy="no",
        save_strategy="no",
        fp16=torch.cuda.is_available(),
        logging_steps=10,
    )
    trainer = Trainer(model=model, args=args, train_dataset=split["train"],
                      eval_dataset=split["test"], data_collator=collator)

    # 5. 학습 전 실측 베이스라인 (하드코딩 아님 — 같은 평가셋으로 직접 측정)
    print("[2/4] 학습 전 베이스라인 평가...")
    base_eval = trainer.evaluate()
    baseline_metrics = {
        "eval_loss": round(base_eval["eval_loss"], 4),
        "perplexity": round(math.exp(min(base_eval["eval_loss"], 20)), 2),
    }

    print("[3/4] LoRA 파인튜닝 실행...")
    trainer.train()
    final_eval = trainer.evaluate()
    final_metrics = {
        "eval_loss": round(final_eval["eval_loss"], 4),
        "perplexity": round(math.exp(min(final_eval["eval_loss"], 20)), 2),
    }

    tracker.log_benchmarks(
        baseline=baseline_metrics,
        final=final_metrics,
        params={
            "base_model": MODEL_NAME,
            "method": "LoRA (r=$lora_r, q_proj/v_proj)",
            "learning_rate": $learning_rate,
            "batch_size": $batch_size,
            "gradient_accumulation_steps": 4,
            "epochs": $epochs,
            "max_length": $max_length,
        },
    )

    print("[4/4] 텔레메트리 저장 중...")
    tracker.save_run()
    print("완료 - 학습 텔레메트리 수집: .telemetry/raw_telemetry.json")


if __name__ == "__main__":
    main()
