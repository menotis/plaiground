# 창업계획서 커밋 제외
*.hwp
*.hwpx
*.pdf

# AI 관련 파일 커밋 제외
.agents/
.claude/
.codex/
*.zip

web_test/
recommend_from_profile/

# 사업기획/투자 관련 문서 (기술 데모와 무관, 비공개 유지)
doc/

.env

etc/

# 런타임 데이터 — 실행 중 생기는 파일은 전부 여기. 소스 폴더에는 쓰지 않는다.
#   var/telemetry  학습 실행 기록·에러 이력·View AI 프레임
#   var/output     생성된 포트폴리오
#   var/generated  생성된 학습 스크립트 (사용자가 직접 고친 내용 포함)
#   var/community  추천·조회 누적, 댓글
var/

# Python
__pycache__/
*.pyc
*.egg-info/

# Node / Vite
node_modules/
dist/
vite_debug.log

# 학습 런타임 로그 (재생성 가능)
results/

# 학습 스크립트가 내려받는 데이터셋 (MNIST 등)
data/

# graphify 코드 그래프 산출물 (재생성 가능)
graphify-out/

# impeccable 디자인 리뷰 스크린샷 및 훅 캐시 (재생성 가능)
# design.json은 디자인 시스템 정의라 추적 대상 — 여기서 제외하지 않는다.
**/.impeccable/review/
**/.impeccable/hook.cache.json

# Windows 폴더 메타데이터
desktop.ini
